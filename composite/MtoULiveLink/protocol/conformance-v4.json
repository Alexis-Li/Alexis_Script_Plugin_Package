{
  "schema_version": 1,
  "protocol_version": 4,
  "cases": [
    {
      "id": "framing-partial-packet",
      "operation": "framing",
      "applies_to": ["maya", "unreal"],
      "payloads": [{"type": "ready", "missing_in_unreal": [], "missing_in_maya": [], "bone_name_remaps": [], "workflow": "animation", "target_morph_count": 0, "accepted_morph_count": 0}],
      "chunk_sizes": [1, 3, 4, 7],
      "expected": {"accepted": true, "message_count": 1, "close": false}
    },
    {
      "id": "framing-combined-packets",
      "operation": "framing",
      "applies_to": ["maya", "unreal"],
      "payloads": [
        {"type": "ready", "missing_in_unreal": [], "missing_in_maya": [], "bone_name_remaps": [], "workflow": "animation", "target_morph_count": 0, "accepted_morph_count": 0},
        {"type": "error", "code": "INVALID_MESSAGE", "message": "bad", "details": "bad payload"}
      ],
      "expected": {"accepted": true, "message_count": 2, "close": false}
    },
    {
      "id": "framing-length-overflow",
      "operation": "framing",
      "applies_to": ["maya", "unreal"],
      "raw_hex": "0000000080000000",
      "expected": {"accepted": false, "error_code": "INVALID_MESSAGE", "close": true, "keywords": ["length"]}
    },
    {
