// MtoU_LiveLink installer: drag this file into a Maya viewport.
//
// It finds the folder it was extracted to and runs
// scripts/mtou_livelink/install.py from there, which registers that folder
// as the MtoULiveLink Maya module. Keep this file ASCII: Maya 2022 does not
// read UTF-8 text in MEL files, so the messages use Python escapes.

global proc mtouInstallLocator() {}

python(
    "def _mtou_install():\n"
  + "    import importlib.util, os, re\n"
  + "    import maya.cmds as cmds\n"
  + "    import maya.mel as mel\n"
  + "    found = mel.eval('whatIs mtouInstallLocator').replace(chr(92), '/')\n"
  + "    match = re.search('(?:[A-Za-z]:/|//[^/]).*$', found)\n"
  + "    if not match:\n"
  + "        cmds.confirmDialog(title='MtoU_LiveLink', button=['OK'], message=(\n"
  + "            '\\u8bf7\\u628a install.mel \\u6587\\u4ef6\\u62d6\\u5165 Maya \\u89c6\\u53e3\\u5b89\\u88c5\\uff0c'\n"
  + "            '\\u4e0d\\u8981\\u628a\\u5b83\\u7684\\u5185\\u5bb9\\u7c98\\u8d34\\u5230\\u811a\\u672c\\u7f16\\u8f91\\u5668\\u4e2d\\u8fd0\\u884c\\u3002\\n'\n"
  + "            'Drag the install.mel file into a Maya viewport; do not paste its contents '\n"
  + "            'into the Script Editor.'))\n"
  + "        return None\n"
  + "    root = os.path.dirname(match.group(0))\n"
  + "    installer = os.path.join(root, 'scripts', 'mtou_livelink', 'install.py')\n"
  + "    if not os.path.isfile(installer):\n"
  + "        cmds.confirmDialog(title='MtoU_LiveLink', button=['OK'], message=(\n"
  + "            '\\u5b89\\u88c5\\u5305\\u4e0d\\u5b8c\\u6574\\uff1a\\u627e\\u4e0d\\u5230 scripts/mtou_livelink/install.py\\u3002'\n"
  + "            '\\u8bf7\\u91cd\\u65b0\\u5b8c\\u6574\\u89e3\\u538b Maya \\u7ec4\\u4ef6\\u540e\\u518d\\u62d6\\u5165 install.mel\\u3002\\n'\n"
  + "            'Incomplete package: scripts/mtou_livelink/install.py is missing. '\n"
  + "            'Extract the whole Maya component again, then drag install.mel in.'))\n"
  + "        return None\n"
  + "    spec = importlib.util.spec_from_file_location('_mtou_livelink_install', installer)\n"
  + "    module = importlib.util.module_from_spec(spec)\n"
  + "    spec.loader.exec_module(module)\n"
  + "    return module.install_from_maya(root)\n"
  + "MTOU_INSTALL_RESULT = _mtou_install()\n"
  + "del _mtou_install\n");
